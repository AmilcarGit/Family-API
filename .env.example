PORT=3032

# Los usuarios se guardan en database/registered_users.json (sin base de datos externa).
# En Render Free ese archivo se reinicia con cada redeploy: es normal para un
# proyecto pequeño/hobby, pero no sirve como almacenamiento a largo plazo.

# Admin (usado solo si no hay admin creado en el JSON)
ADMIN_USERNAME=admin
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_KEY=genera-una-key-larga-y-aleatoria
ADMIN_IMG=https://i.ibb.co/jPzxnp6x/NAGI-REO-RIN-SAE-ISAGI.jpg

# Gemini (si usas el endpoint /api/ai/gemini)
GEMINI_COOKIE=

# Límites / seguridad
GLOBAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10